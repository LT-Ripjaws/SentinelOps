MONGODB_URI=mongodb://sentinelops_root:sentinelops_password@localhost:27017/sentinelops?authSource=admin
PORT=4000

# Auth cookie behavior:
# - development keeps cookies usable over plain http://localhost
# - production should set secure cookies over HTTPS
NODE_ENV=development

# Frontend origin allowed to send credentialed requests with cookies.
CORS_ORIGIN=http://localhost:3000

# openssl rand -hex 64
JWT_ACCESS_SECRET=...
JWT_REFRESH_SECRET=...
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d 

# These are for seeds. To Test database seeding, replace these with the desired passwords for the seeded analyst and manager accounts.
# Then just run 'npm run seed'
SEED_ANALYST_PASSWORD=replace-this-for-local-seed
SEED_MANAGER_PASSWORD=replace-this-for-local-seed
